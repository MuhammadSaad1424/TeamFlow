# Application Settings
APP_NAME=TeamFlow AI
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# API Configuration
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/teamflow_ai.db
DATABASE_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=models/gemini-embedding-2

# Vector Database
VECTOR_DB_TYPE=chromadb  # chromadb or pinecone
CHROMADB_PATH=./data/chromadb
CHROMADB_URL=http://localhost:8001
# Optional Pinecone Configuration
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=your_pinecone_environment
# PINECONE_INDEX_NAME=teamflow-ai

# Code Parsing
MAX_FILE_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Settings
TOP_K_RETRIEVAL=5
TOP_K_RERANKING=3
MIN_CONFIDENCE_SCORE=0.6

# Rate Limiting
RATE_LIMIT_QUERIES_PER_DAY={"free": 100, "pro": 10000, "enterprise": 1000000}

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (Optional)
# SENTRY_DSN=your_sentry_dsn

# Feature Flags
ENABLE_GRAPHRAG=False
ENABLE_HALLUCINATION_CHECK=True
ENABLE_CONFIDENCE_SCORING=True
