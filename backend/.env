# Application Settings
APP_NAME=TeamFlow AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API Configuration
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/teamflow_ai.db
DATABASE_ECHO=False

# Redis Configuration (optional - disabled for now)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=teamflow-ai-super-secret-key-2024-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=Ov23li4Vk5vo67e6IZ76
GITHUB_CLIENT_SECRET=e902de96e7af2e416e5ab6cbd61f35f58bcb231c
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Gemini AI Configuration (replaces OpenAI)
GEMINI_API_KEY=AIzaSyAk8HMwmyt9oKWQtegMAsZ5RcQ24Cq-4MI
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-2

# OpenAI (disabled - using Gemini instead)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector Database
VECTOR_DB_TYPE=chromadb
CHROMADB_PATH=./data/chromadb
CHROMADB_URL=http://localhost:8001

# Code Parsing
MAX_FILE_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Settings
TOP_K_RETRIEVAL=5
TOP_K_RERANKING=3
MIN_CONFIDENCE_SCORE=0.6

# Rate Limiting
RATE_LIMIT_QUERIES_PER_DAY={"free": 100, "pro": 10000, "enterprise": 1000000}

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_GRAPHRAG=False
ENABLE_HALLUCINATION_CHECK=True
ENABLE_CONFIDENCE_SCORING=True
